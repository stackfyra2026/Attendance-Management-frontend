# Copy to .env and fill in your values. NEVER commit the real .env file.

# App name displayed in the UI
VITE_APP_NAME=StaffFlow

# Backend API base URL (must match the actual API, e.g. https://api.example.com/api/v1)
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Google Maps API key for the location map (web only; native uses the device geolocation)
VITE_GOOGLE_MAPS_API_KEY=

# Firebase Cloud Messaging (web push) - set these to enable browser notifications
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=